# Local (non-Docker) `cargo run` connects here directly.
DATABASE_URL=postgres://postgres:password@localhost:5432/fplx_db

# Signs/verifies session JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string

# NEVER set true outside local development — bypasses wallet signature auth.
DEV_MODE=false
DEV_USER_WALLET=

# Comma-separated origins allowed to call the API from a browser (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# --- docker-compose only (ignored by `cargo run`) ---
# The app container is wired to the postgres container internally; these
# just parameterize that connection and the postgres container itself.
POSTGRES_USER=fplx
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fplx

# Where the browser can reach the API — baked into the web image at build
# time, so a real deployment sets this to the API's public URL.
NEXT_PUBLIC_API_URL=http://localhost:8080
