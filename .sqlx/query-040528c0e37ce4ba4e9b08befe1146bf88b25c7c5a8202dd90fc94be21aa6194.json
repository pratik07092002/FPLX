{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            pms.id,\n            p.position,\n            pms.team_side,\n            pms.minutes,\n            pms.goals,\n            pms.assists,\n            pms.own_goals,\n            pms.penalties_saved,\n            pms.penalties_missed,\n            pms.yellow_cards,\n            pms.red_cards,\n            pms.saves,\n            pms.bonus,\n            pms.defensive_contribution,\n            f.home_score,\n            f.away_score\n        FROM player_match_stats pms\n        JOIN players p ON p.id = pms.player_id\n        JOIN fixtures f ON f.id = pms.fixture_id\n        WHERE f.gameweek = $1\n        ",
