{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.id,\n            p.first_name,\n            p.second_name,\n            p.photo,\n            p.team_id,\n            t.name AS team_name,\n            t.short_name AS team_short_name,\n            p.position,\n            p.now_cost,\n            p.form,\n            p.total_points,\n            p.news\n        FROM players p\n        JOIN teams t ON t.id = p.team_id\n        ORDER BY p.position, p.now_cost DESC\n        ",
